# ---- Required ----
BOT_TOKEN=                # from @BotFather. NEVER commit or paste this anywhere public.

# ---- Strongly recommended ----
ADMIN_CHAT_ID=            # send /id to your bot to find it. Gets health alerts + /status
DB_PATH=/data/bot.db      # must be on a persistent disk

# ---- Optional ----
ACCESS_CODE=              # if set, users must send: /start <code>
PRESET=INTRADAY           # SCALP1M | SCALP | INTRADAY (15m, default) | SWING (1h)
SYMBOLS=BTCUSDT,PAXGUSDT  # gold options: PAXGUSDT (spot) or XAUUSDT (perp)
MIN_SCORE=50

# Assumed ROUND-TRIP trading cost in basis points (fees + spread + slippage).
# This decides which signals are tradeable. Set it to what you really pay.
COST_BPS_CRYPTO=10
COST_BPS_GOLD=10

# Any Config field can be overridden by its UPPER_CASE name.
